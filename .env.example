# Runtime settings
V2RAY_AUTO_API_KEY=change-me
V2RAY_AUTO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
V2RAY_AUTO_DEFAULT_REMOTE_DIR=/opt/v2ray_auto
V2RAY_AUTO_COMMAND_TIMEOUT=900
V2RAY_AUTO_LOG_LEVEL=INFO

# Optional email notification settings. Leave empty to disable email delivery.
V2RAY_AUTO_SMTP_HOST=
V2RAY_AUTO_SMTP_PORT=587
V2RAY_AUTO_SMTP_USERNAME=
V2RAY_AUTO_SMTP_PASSWORD=
V2RAY_AUTO_SMTP_SENDER=
