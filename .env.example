# Runtime settings
V2RAY_AUTO_API_KEY=change-me
V2RAY_AUTO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
V2RAY_AUTO_DEFAULT_REMOTE_DIR=/opt/v2ray_auto
V2RAY_AUTO_COMMAND_TIMEOUT=900
V2RAY_AUTO_LOG_LEVEL=INFO

# Xray version installed during bootstrap. Xray v26+ reworked REALITY and
# older clients (Shadowrocket <= 2.2.32, Xray-core <= v1.8.x) can no longer
# authenticate, which looks like "connected but nothing loads".
# Keep a pinned release, or set to "latest" to always install the newest.
V2RAY_AUTO_XRAY_VERSION=v25.9.11
